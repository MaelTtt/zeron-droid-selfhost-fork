	"tokenColors": [
		{
			"scope": ["comment"],
			"settings": { "foreground": "#8a80a0", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#8b5cf6" }
		},
		{
			"scope": ["string.regexp", "string.escape", "string.special"],
			"settings": { "foreground": "#7c5cff" }
		},
		{
			"scope": ["constant", "constant.numeric", "constant.language", "constant.character.escape", "support.constant"],
			"settings": { "foreground": "#8b5cf6" }
		},
		{
			"scope": ["keyword", "keyword.control", "keyword.operator.new", "storage.modifier"],
			"settings": { "foreground": "#6f4bb8" }
		},
		{
			"scope": ["keyword.operator", "punctuation.definition.operator"],
			"settings": { "foreground": "#4a4062" }
		},
		{
			"scope": ["storage", "storage.type"],
			"settings": { "foreground": "#7c5cff" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
			"settings": { "foreground": "#6f4bb8" }
		},
		{
			"scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
			"settings": { "foreground": "#8b5cf6" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#7c5cff" }
		},
		{
			"scope": ["entity.other.attribute-name", "attribute.name"],
			"settings": { "foreground": "#6f4bb8" }
		},
		{
			"scope": ["variable", "variable.other", "variable.other.readwrite"],
			"settings": { "foreground": "#2d2640" }
		},
		{
			"scope": ["variable.other.property", "meta.property-name"],
			"settings": { "foreground": "#4a4062" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#4a4062" }
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
			"settings": { "foreground": "#6f6a7a" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#b3261e" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#6f4bb8", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.underline"],
			"settings": { "fontStyle": "underline" }
		},
		{
			"scope": ["markup.link", "string.other.link"],
			"settings": { "foreground": "#6f4bb8" }
		},
		{
			"scope": ["markup.quote"],
			"settings": { "foreground": "#8a80a0", "fontStyle": "italic" }
		},
		{
			"scope": ["markup.raw", "markup.inline.raw"],
			"settings": { "foreground": "#8b5cf6" }
		}
	]
}
